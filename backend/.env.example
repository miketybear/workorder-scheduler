WOS_ENVIRONMENT=development
WOS_DATABASE_URL=postgresql+psycopg://scheduler:replace-me@localhost:5432/scheduler
# Uncomment and fill ALL fields to enable SSO. HTTPS is required, including local SSO tests.
# WOS_ENTRA__TENANT_ID=
# WOS_ENTRA__CLIENT_ID=
# WOS_ENTRA__CLIENT_SECRET=
# WOS_ENTRA__REDIRECT_URI=https://your-host/api/auth/callback
# WOS_ENTRA__TIMEOUT_SECONDS=10
# Maximo registry is keyed by the connection UUID in PostgreSQL; writes default disabled.
# See docs/maximo-reader.md; never paste keys from the workbook.
# WOS_MAXIMO={}
# Add "person_login_domain": "your-company-domain" to a connection for PERSON-derived read grants.
# See docs/person-access.md; only verified Entra login claims are used as PERSON locators.
# HTTP is opt-in per registry entry: "allow_http_for_test": true (JSON boolean).
# Requires DB connection environment=test; WOS_ENVIRONMENT=production rejects HTTP.
# HTTPS certificate verification and Entra HTTPS requirements are unchanged.
# WOS_MAXIMO_CA_BUNDLE=/run/secrets/internal-ca.pem
# Only after audited live contract acceptance on a configured Onshore TEST connection:
# add "conditional_write_contract": "native_rowstamp_test" to that registry entry.
# Requires app development/test, DB system=onshore/environment=test and eligible CM WO.
# Staging/production reject this TEST contract; other WO types and explicit clears stay blocked.
# No token/HTTP/credential fallback and no automatic retry of unknown writes.
