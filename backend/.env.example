WOS_ENVIRONMENT=development
WOS_WORK_ORDER_SNAPSHOT_TTL_SECONDS=120
WOS_WORK_ORDER_SNAPSHOT_MAX_ENTRIES=8
WOS_WORK_ORDER_SNAPSHOT_MAX_ROWS=20000
WOS_WORK_ORDER_SNAPSHOT_MAX_BYTES=33554432
WOS_DATABASE_URL=postgresql+psycopg://scheduler:replace-me@localhost:5432/scheduler
# Whole WO read/local draft request budget (1..300 seconds); staging proxy must exceed it.
WOS_READ_DRAFT_REQUEST_TIMEOUT_SECONDS=180
# Uncomment and fill ALL fields to enable SSO. HTTPS is required, including local SSO tests.
# WOS_ENTRA__TENANT_ID=
# WOS_ENTRA__CLIENT_ID=
# WOS_ENTRA__CLIENT_SECRET=
# WOS_ENTRA__REDIRECT_URI=https://your-host/api/auth/callback
# WOS_ENTRA__TIMEOUT_SECONDS=10
# Enable only after Microsoft Graph delegated User.Read consent is available.
# WOS_ENTRA__PROFILE_PHOTO_ENABLED=true  (default; set false only if the tenant blocks delegated User.Read)
# Maximo registry is keyed by the connection UUID in PostgreSQL; writes default disabled.
# See docs/maximo-reader.md; never paste keys from the workbook.
# WOS_MAXIMO={}
# Values shared by every connection (a connection's own value overrides them):
# WOS_MAXIMO_DEFAULTS={"open_statuses":["APPR"],"crew_groups":{},"person_login_domain":"your-company-domain"}
# Only open_statuses, crew_groups and person_login_domain are allowed here; never keys or URLs.
# Add "person_login_domain": "your-company-domain" to a connection for PERSON-derived read grants.
# See docs/person-access.md; only verified Entra login claims are used as PERSON locators.
# HTTP is opt-in per registry entry: "allow_http_for_test": true (JSON boolean).
# Requires DB connection environment=test; WOS_ENVIRONMENT=production rejects HTTP.
# HTTPS certificate verification and Entra HTTPS requirements are unchanged.
# WOS_MAXIMO_CA_BUNDLE=/run/secrets/internal-ca.pem
# Only after audited live contract acceptance on a configured Onshore TEST connection:
# add "conditional_write_contract": "native_rowstamp_test" to that registry entry.
# Requires app development/test, DB system=onshore/environment=test and eligible CM WO.
# Staging/production reject this TEST contract; other WO types and explicit clears stay blocked.
# No token/HTTP/credential fallback and no automatic retry of unknown writes.
# Task planning uses collection_url ending /oslc/os/BDSCHED_WO after read contract acceptance.
# Add "task_load_contract": "bdsched_assignment_test" only after labor/date+paging verification.
# Explicit "paging_origin_aliases": ["https://advertised-host"] permits advertised links
# to be canonicalized back to the configured connection; the alias is never requested.
# Task upload is separate: "assignment_write_contract": "native_assignment_rowstamp_test"
# stays absent until audited assignment write/restore/conflict acceptance on Onshore TEST.
# The old WO conditional_write_contract does not enable WO writes on BDSCHED_WO.
# Daily plan uploads additionally require "assignment_daily_write_contract":
# "native_daily_assignment_rowstamp_test", absent by default. Only configured Onshore TEST
# with verified assignment_write_contract + task_load_contract and app development/test.
# This enables source-preserving MERGE/Add plus read-only recovery, never remote deletion.
# BD_WO route accounts (TEST-only, see docs/maximo-workflow-route.md): one shared position
# account API key per discipline, used only for workflow route actions. Staging/production reject it.
# WOS_MAXIMO__<connection-uuid>__WORKFLOW_ROUTE_ACCOUNTS={"E&I":{"personid":"ENISUP","api_key":"replace-me"}}
# Optional per-connection route contract (TEST-only). The route is enabled by the account above plus
# BDSCHED_WO and conditional_write_contract; it uses the active BD_WO revision and locks itself when the
# workflow definition no longer matches. Defaults: BD_WO, node 34, nodes {20: 427, 40: 437},
# MXAPIWFASSIGNMENT and group ALLSUPN. Pin a revision only if you want to:
# WOS_MAXIMO__<connection-uuid>__WORKFLOW_ROUTE={"revision":27}
