# Private server-side file; do not commit the filled copy. chmod 600, operator-owned.
WOS_DATABASE_URL=
# Runtime DSN: postgresql+psycopg://wos_runtime:URL_ENCODED_PASSWORD@db:5432/scheduler
WOS_ENTRA__TENANT_ID=
WOS_ENTRA__CLIENT_ID=
WOS_ENTRA__CLIENT_SECRET=
WOS_ENTRA__REDIRECT_URI=
# HTTPS callback ending /api/auth/callback, registered in Entra.
WOS_ENTRA__TIMEOUT_SECONDS=10
# Whole WO read/draft endpoint budget, including PERSON, crew, rechecks and DB.
# Allowed 1..300 seconds; proxy read 310s, backend/nginx drain 320s, Docker stop 330s.
WOS_READ_DRAFT_REQUEST_TIMEOUT_SECONDS=180
# Configure approved connection UUIDs and metadata in DB separately.
# Statuses, crew groups and PERSON domain shared by all connections; override per connection if needed.
WOS_MAXIMO_DEFAULTS={}
# Per connection: HTTPS base_url (backend appends /oslc/os/BDSCHED_WO) and api_key (plus anything that differs from the defaults).
# No conditional_write_contract in staging; upload is disabled.
WOS_MAXIMO={}
# Built-in system trust store is used. Private Maximo CA mounting is not configured
# by this template; arrange a reviewed CA mount before using a private-CA endpoint.
