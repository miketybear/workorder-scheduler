# Non-secret Compose inputs; use absolute paths on Ubuntu. Copy outside the repo.
# Images must be release references ending @sha256:<digest>, not mutable tags.
WOS_BACKEND_IMAGE=
WOS_WEB_IMAGE=
WOS_RUNTIME_ENV_FILE=
WOS_MIGRATION_ENV_FILE=
WOS_DB_PASSWORD_FILE=
WOS_TLS_CERT_FILE=
WOS_TLS_KEY_FILE=
# 443 when WOS nginx owns the host; 127.0.0.1:9443 behind a shared host nginx (host-nginx-wos.conf).
WOS_WEB_PUBLISH=
