# Local Compose only. Provision roles first; URL-encode password characters.
POSTGRES_PASSWORD=
WOS_DATABASE_URL=
WOS_MIGRATION_DATABASE_URL=
# Runtime format: postgresql+psycopg://wos_runtime:URL_ENCODED_PASSWORD@db:5432/scheduler
# Migration format: postgresql+psycopg://wos_owner:URL_ENCODED_PASSWORD@db:5432/scheduler
# POSTGRES_PASSWORD is the database administrator password, never a backend credential.
# See docs/database-operations.md; this example does not create roles automatically.
